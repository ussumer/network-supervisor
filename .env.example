# 复制为 .env 后按需修改：copy .env.example .env
# Windows 上直接跑 scripts/setup-windows.ps1 会自动生成这个文件

# 代理客户端配置目录（含 secret 的那个目录）
# FlClash:        C:/Users/<用户名>/AppData/Roaming/com.follow/clash
# Clash Verge Rev:C:/Users/<用户名>/AppData/Roaming/io.github.clash-verge-rev.clash-verge-rev
FLCLASH_DIR=C:/Users/<用户名>/AppData/Roaming/com.follow/clash

# 控制器地址（容器内视角；host.docker.internal 指向宿主机）
# FlClash 常用 9090，Clash Verge Rev 常用 9097
CLASH_API=http://host.docker.internal:9090

# 自动读 secret 失败时，可把 config.yaml 里的 secret 抄到这里
CLASH_SECRET=

# 看板端口（只绑 127.0.0.1）
PORT=8787

# 套餐额度与计费口径：updown = 上传+下载，down = 只算下载
BUDGET_GB=100
BILLING_MODE=updown

# 时区偏移（北京时间 = 8）
TZ_OFFSET_HOURS=8

# 明细保留天数
DETAIL_RETENTION_DAYS=30

# ------------------------------------------------- 手机上报 / 局域网访问
# 监听地址：127.0.0.1 = 只有本机能开；0.0.0.0 = 局域网可访问（手机上报必须）
BIND_ADDR=127.0.0.1

# 手机上报口令（手机端 --token 填这个）。留空 = 关闭上报接口
INGEST_TOKEN=

# 看板访问口令：设了之后第一次访问 /?k=口令，浏览器会记住
DASHBOARD_TOKEN=

# 本机在看板「设备」里显示的名字
DEVICE_NAME=pc
